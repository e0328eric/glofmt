//! Syntax-directed layout over the compiler's lossless tokens. Operator syntax
//! is collected before layout; input is never compiled or evaluated.
#import "glosso.glo";
#import "syntax.glo";
#import "operators.glo";
#import "String_Builder";
#import "Strings";
#import "Memory/Ownership";

Fmt_Writer :: struct {
    out: String_Builder;
    indent: ssize = 4;
    tabs: bool;
    depth: ssize;
    column: ssize;
    line_start: bool = true;
    pending: bool;
    blank_pending: bool;
    continuation: bool;
    // Braceless if conditions continue under their first token, this many
    // columns past the line's indentation; 0 elsewhere.
    condition_align: ssize;
    control_header: bool;
    disabled_start: ssize = -1;
}
fmt_newline :: (writer: *Fmt_Writer) {
    // Trimming here would corrupt comment or raw-string bytes.
    if writer.disabled_start < 0 && !writer.line_start writer.out.write_byte(#char "\n");
    writer.line_start = true;
    writer.column = 0;
    writer.pending = false;
}
fmt_blank_line :: (writer: *Fmt_Writer) {
    fmt_newline(writer);
    if writer.disabled_start >= 0 return;
    count := writer.out.buf.count;
    if count > 0 && (count < 2 || writer.out.buf[count - 2] != #char "\n")
        writer.out.write_byte(#char "\n");
}
fmt_write :: (writer: *Fmt_Writer, text: str, space: bool, extra_indent: ssize = 0) {
    if writer.line_start {
        depth := writer.depth + extra_indent;
        align: ssize = 0;
        if      writer.continuation && writer.condition_align > 0 align = writer.condition_align;
        else if writer.continuation                               depth += 1;
        if writer.disabled_start < 0 {
            if writer.tabs {
                for 0..depth writer.out.write_byte(#char "\t");
            } else {
                for 0..depth * writer.indent writer.out.write_byte(#char " ");
            }
            // Tabs indent; spaces align.
            for 0..align writer.out.write_byte(#char " ");
        }
        writer.column = depth * writer.indent + align;
        writer.line_start = false;
    } else if space {
        if writer.disabled_start < 0 writer.out.write_byte(#char " ");
        writer.column += 1;
    }
    if writer.disabled_start < 0 writer.out.write_string(text);
    for byte: text.bytes() {
        if      byte == #char "\n"        writer.column = 0;
        else if byte < 128 || byte >= 192 writer.column += 1;
    }
}
// Alignment padding within a line, after its indentation.
fmt_pad :: (writer: *Fmt_Writer, count: ssize) {
    if count < 1 count = 1;
    if writer.disabled_start < 0 {
        for 0..count writer.out.write_byte(#char " ");
    }
    writer.column += count;
}

fmt_operand_keyword :: (text: str) -> bool {
    if text == {
    case "return", "if", "ifx", "else", "while", "for", "case", "defer", "using", "where", "in";
        return true;
    else;
        return false;
    }
}
// Whether `token` can begin an operand, so that a suffix-capable operator
// before it may instead be the operand's prefix, or binary.
fmt_starts_operand :: (ops: *Fmt_Operators, token: *Fmt_Token) -> bool {
    if token.kind == {
    case "Ident", "Int", "Float", "Str", "CStr", "BStr", "MlStr", "LParen", "LBracket", "Dot",
    "DotBrace", "DotBracket", "Directive", "Backtick", "DoubleBacktick", "Dollar", "Cast",
    "Acast", "Ifx", "Struct", "Union", "Enum", "Context";
        return true;
    case "Op", "OpName";
        return token.text == "?" || fmt_operator(ops, token.text).prefix;
    else;
        return false;
    }
}
// How the compiler reads a suffix-capable operator that an operand follows
// when it has another reading too: attached to its left operand only it is
// the suffix (`x? y`, `x?.y`; attached on both sides a binary reading wins),
// attached to its right operand only it is the prefix of the next operand
// (`ifx c ?a else null`), and detached on both sides it is binary.
fmt_spaced_reading :: (
    tokens: []Fmt_Token,
    previous: ssize,
    at: ssize,
    next: ssize,
    op: Fmt_Operator
) -> str {
    before := previous >= 0 && tokens[previous].end < tokens[at].start;
    after := tokens[at].end < tokens[next].start;
    if !before && !after && op.binary return "binary";
    if !before                        return "suffix";
    if !after && op.prefix            return "prefix";
    return "binary";
}
fmt_symbolic :: (token: *Fmt_Token) -> bool {
    return token.kind == "Op" || token.kind == "Range" || token.kind == "RangeInclusive";
}
fmt_directive_modifiers :: (text: str) -> bool {
    if text == {
    case "#inline", "#expand", "#public", "#library", "#string", "#derive", "#insert";
        return true;
    else;
        return false;
    }
}

// Mark prefix/infix/postfix roles and type constructors before whitespace.
fmt_spacing :: (tokens: *[..]Fmt_Token, ops: *Fmt_Operators) {
    for i: 0..tokens.*.count {
        token := &tokens.*[i];
        token.prefix = false;
        token.suffix = false;
        token.binary = false;
        token.type_head_start = false;
        token.type_array = false;
        token.cast_type = false;
        token.lambda_open = false;
        token.lambda_close = false;
        token.lambda_parameter = false;
        token.directive_modifier = false;
    }
    // A type before ':::' starts a declaration, even after a body with no ';'.
    // Skip paired type arguments/counts while finding the head's first token.
    for i: 0..tokens.*.count {
        if tokens.*[i].text != ":::" continue;
        start := i;
        at := fmt_previous_code(tokens.view(), i - 1);
        while at >= 0 && tokens.*[at].parent == tokens.*[i].parent {
            if tokens.*[at].text == ";" || tokens.*[at].text == "}" break;
            start = at;
            if fmt_close(tokens.*[at].text) start = tokens.*[at].pair;
            at = fmt_previous_code(tokens.view(), start - 1);
        }
        if start < i tokens.*[start].type_head_start = true;
    }
    operand := true;
    type_context := false;
    previous: ssize = -1;
    for i: 0..tokens.*.count {
        token := &tokens.*[i];
        text := token.text;
        if fmt_comment(token.kind) {
            token.space = true;
            continue;
        }
        if token.type_head_start {
            operand = true;
            type_context = true;
        }
        prev_text := "";
        prev_kind := "";
        if previous >= 0 {
            prev_text = tokens.*[previous].text;
            prev_kind = tokens.*[previous].kind;
        }
        space := previous >= 0;
        if text == "," || text == ",," || text == ";" || text == ":" || fmt_close(text)
            space = false;
        if prev_text == "(" || prev_text == "[" || prev_text == ".[" || prev_text == "." ||
           prev_text == "$" || prev_text == "`" || prev_text == "``"
            space = false;
        if previous >= 0 {
            prev := &tokens.*[previous];
            if prev.prefix && (fmt_symbolic(prev) || prev.text == "...")            space = false;
            if prev.text == ".." || prev.text == "..="                              space = false;
            if prev.text == "]" && prev.pair >= 0 && tokens.*[prev.pair].type_array space = false;
            // Modifier commas are neither expression nor list separators.
            // Follow chains such as #string,oneline,escape across comments.
            if text == "," {
                token.directive_modifier = (
                    prev_kind == "Directive" && fmt_directive_modifiers(prev_text)
                )
                    || (prev_kind == "Ident" && prev.directive_modifier);
            } else if token.kind == "Ident" && prev_text == "," && prev.directive_modifier {
                token.directive_modifier = true;
                space = false;
            }
        }
        token.type_context = type_context;
        token.operand_context = operand;
        was_operand := operand;
        if operand && text == "|" && !token.lambda_close {
            next := i + 1;
            while next < tokens.*.count && tokens.*[next].parent == token.parent {
                if tokens.*[next].text == "|" {
                    token.lambda_open = true;
                    tokens.*[next].lambda_close = true;
                    for parameter: i + 1..next tokens.*[parameter].lambda_parameter = true;
                    break;
                }
                if tokens.*[next].text == ";" || tokens.*[next].text == "{" break;
                if fmt_open(tokens.*[next].text) next = tokens.*[next].pair;
                next += 1;
            }
        }
        if previous >= 0 && tokens.*[previous].lambda_open space = false;
        if token.lambda_close {
            space = false;
            operand = true;
            type_context = false;
        } else if token.lambda_open || (operand && text == "||") {
            operand = true;
            type_context = false;
        } else if fmt_open(text) {
            if text == "(" {
                // Keep parenthesized cast operands attached: cast(T)(value).
                if !operand || prev_kind == "Directive" || prev_text == "cast" ||
                   (previous >= 0 && tokens.*[previous].cast_type)
                    space = false;
                token.cast_type = prev_text == "cast";
                type_context = token.cast_type;
            } else if text == "[" {
                token.type_array = operand;
                if !operand space = false;
            } else if text == ".{" || text == ".[" {
                if !operand space = false;
                type_context = false;
            } else type_context = false;
            operand = true;
        } else if fmt_close(text) {
            open := &tokens.*[token.pair];
            type_context = open.type_context;
            // cast(T) still needs its operand; a following '&' is a prefix.
            token.cast_type = open.cast_type;
            operand = open.type_array || token.cast_type;
            if open.type_array                                        type_context = true;
            if text == "}" && open.text == ".{" && token.pair + 1 < i space = true;
        } else if text == ":" || text == "->" {
            operand = true;
            type_context = true;
        } else if text == "::" || text == ":=" || text == "::=" || text == ":::" || text == "=" {
            operand = true;
            type_context = false;
        } else if text == "," || text == ",," || text == ";" {
            operand = true;
            type_context = false;
        } else if text == "." {
            // Value directives (#self.value) end an operand; others such as
            // #pattern take an enum literal operand: #pattern .Ok(x) := ...
            if !operand space = false;
            operand = true;
        } else if text == "..." {
            // Variadic parameters prefix their type; expansions follow a value.
            token.prefix = operand;
            token.suffix = !operand;
            if token.suffix space = false;
        } else if text == "$" || text == "`" || text == "``" {
            operand = true;
        } else {
            op := fmt_operator(ops, text);
            next := fmt_next_code(tokens.view(), i + 1);
            boundary := next == tokens.*.count;
            if !boundary
                boundary = fmt_close(tokens.*[next].text) || tokens.*[next].text == "," || tokens.*[next].text == ";";
            if token.kind == "OpName" && next < tokens.*.count && tokens.*[next].text == "::" {
                operand = false;
            } else if !operand && text == "!" {
                // E!T is a type constructor, including in expression position.
                token.prefix = true;
                space = false;
                operand = true;
            } else if operand && op.prefix {
                token.prefix = true;
                operand = true;
            } else if !operand && op.suffix && !boundary && (op.prefix || op.binary) && fmt_starts_operand(
                ops,
                &tokens.*[next]
            ) && fmt_spaced_reading(tokens.view(), previous, i, next, op) != "suffix" {
                // The compiler reads such an operator by its spacing; keep it.
                if fmt_spaced_reading(tokens.view(), previous, i, next, op) == "prefix" {
                    token.prefix = true;
                } else token.binary = true;
                operand = true;
            } else if !operand && op.suffix && (!op.binary || boundary) {
                token.suffix = true;
                if fmt_symbolic(token) || text == ".*" || text == ".&" space = false;
                operand = false;
            } else if (fmt_symbolic(token) || token.kind == "OpName" || op.binary) && text != "---" {
                token.binary = true;
                operand = true;
            } else if fmt_operand_keyword(text) {
                operand = true;
                type_context = false;
            } else if token.kind == "Directive" {
                operand = text != "#self" && text != "#Self_Type" && text != "#source_location" && text != "#context";
            } else if (text == "const" || text == "volatile") && (
                type_context || (
                    previous >= 0 && tokens.*[previous].prefix && prev_text.starts_with("*") && fmt_pointer_operator(
                        prev_text
                    )
                )
            ) {
                operand = true;
                type_context = true;
            } else operand = false;
            if (text == ".." || text == "..=") && !was_operand space = false;
        }
        // Don't merge separate operators into a custom operator or comment.
        // '?' is always separate punctuation in the Glosso lexer.
        if previous >= 0 && prev_kind == "Op" &&
           token.kind == "Op" && prev_text != "?" && text != "?"
            space = true;
        // Literal prefixes are adjacency-sensitive despite identical tokens.
        if previous >= 0 && tokens.*[previous].end == token.start && prev_kind == "Ident" &&
           (token.kind == "Str" || token.kind == "MlStr" || text == "#string")
            space = false;
        if i > 0 &&
           fmt_comment(tokens.*[i - 1].kind) && !fmt_close(text) &&
           text != "," && text != ";"
            space = true;
        token.space = space;
        previous = i;
    }
}

fmt_visibility_group :: (tokens: []Fmt_Token, open: ssize) -> bool {
    at := fmt_previous_code(tokens, open - 1);
    // Skip audience arguments and modifier chains already identified by spacing.
    if at >= 0 && tokens[at].text == ")" at = fmt_previous_code(tokens, tokens[at].pair - 1);
    while at >= 0 && tokens[at].directive_modifier at = fmt_previous_code(tokens, at - 1);
    if at < 0 || (tokens[at].text != "#public" && tokens[at].text != "#private") return false;
    // T ::: #public { ... } is an inherent method block, which adds a scope.
    before := fmt_previous_code(tokens, at - 1);
    return before < 0 || tokens[before].text != ":::";
}

// Trailing commas and comments request vertical lists (zig fmt); a width
// budget also expands long lists (rustfmt). Measurements are bottom-up.
fmt_measure :: (tokens: *[..]Fmt_Token) {
    i := tokens.*.count;
    while i > 0 {
        i -= 1;
        token := &tokens.*[i];
        token.flat_width = fmt_width(token.text);
        token.hardline = token.kind == "LineComment" || token.kind == "MlStr" || token.text.contains(
            "\n"
        );
        if !fmt_open(token.text) continue;
        if token.block           token.visibility_group = fmt_visibility_group(tokens.view(), i);
        end := token.pair;
        if token.block && end > i + 1 token.hardline = true;
        last := fmt_previous_code(tokens.view(), end - 1);
        if last > i && tokens.*[last].text == "," token.hardline = true;
        at := i + 1;
        while at <= end {
            child := &tokens.*[at];
            if child.space token.flat_width += 1;
            token.flat_width += child.flat_width;
            if child.hardline token.hardline = true;
            if fmt_open(child.text) at = child.pair + 1;
            else                    at += 1;
        }
    }
}

fmt_member_dot :: (token: *Fmt_Token) -> bool {
    return token.text == "." && !token.operand_context;
}
// Calls, indexing, and initializers attached to a preceding operand.
fmt_postfix_group :: (token: *Fmt_Token) -> bool {
    return (token.text == "(" || token.text == "[" || token.text == ".{" || token.text == ".[")
        && !token.operand_context;
}
// The first token of the operand before `dot`, or -1 when `dot` continues an
// earlier member access, so that each postfix sequence is visited once.
fmt_chain_root :: (tokens: []Fmt_Token, dot: ssize) -> ssize {
    at := fmt_previous_code(tokens, dot - 1);
    while at >= 0 {
        token := &tokens[at];
        if fmt_close(token.text) {
            open := token.pair;
            if tokens[open].text == "{"          return -1;
            if !fmt_postfix_group(&tokens[open]) return open;
            at = fmt_previous_code(tokens, open - 1);
        } else if token.suffix {
            at = fmt_previous_code(tokens, at - 1);
        } else {
            before := fmt_previous_code(tokens, at - 1);
            if before >= 0 && fmt_member_dot(&tokens[before]) return -1;
            return at;
        }
    }
    return -1;
}
// A chain has at least two method calls after its root. Leading field
// accesses join the root; every element from the first call on can break
// onto its own line (Rust style guide). A line break before one of those
// elements in a block requests vertical layout, like a trailing comma.
fmt_chains :: (source: str, tokens: *[..]Fmt_Token) {
    for i: 0..tokens.*.count {
        token := &tokens.*[i];
        token.chain = -1;
        token.chain_root_end = -1;
        token.chain_end = -1;
        token.chain_width = 0;
        token.chain_vertical = false;
        token.chain_indented = false;
        token.chain_broken = false;
    }
    for i: 0..tokens.*.count {
        if !fmt_member_dot(&tokens.*[i]) continue;
        root := fmt_chain_root(tokens.view(), i);
        if root < 0 continue;
        root_end := fmt_previous_code(tokens.view(), i - 1);
        end := root_end;
        first_call: ssize = -1;
        calls := 0;
        at := i;
        while at < tokens.*.count && fmt_member_dot(&tokens.*[at]) {
            name := fmt_next_code(tokens.view(), at + 1);
            if name >= tokens.*.count                                          break;
            if fmt_open(tokens.*[name].text) || fmt_close(tokens.*[name].text) break;
            element_end := name;
            next := fmt_next_code(tokens.view(), name + 1);
            call := next < tokens.*.count && tokens.*[next].text == "("
                && fmt_postfix_group(&tokens.*[next]);
            while next < tokens.*.count {
                if      fmt_postfix_group(&tokens.*[next]) element_end = tokens.*[next].pair;
                else if tokens.*[next].suffix              element_end = next;
                else                                       break;
                next = fmt_next_code(tokens.view(), element_end + 1);
            }
            if call {
                calls += 1;
                if first_call < 0 first_call = at;
            } else if first_call < 0 root_end = element_end;
            end = element_end;
            at = next;
        }
        if calls < 2 continue;
        head := &tokens.*[root];
        head.chain_root_end = root_end;
        head.chain_end = end;
        tokens.*[root_end].chain = root;
        tokens.*[end].chain = root;
        // Statement terminators and separators stay on the chain's last line.
        width: ssize = 0;
        at = root;
        while at <= end {
            child := &tokens.*[at];
            if at > root && child.space width += 1;
            width += child.flat_width;
            if fmt_open(child.text) at = child.pair + 1;
            else                    at += 1;
        }
        after := fmt_next_code(tokens.view(), end + 1);
        if after < tokens.*.count && (tokens.*[after].text == ";" || tokens.*[after].text == ",")
            width += 1;
        head.chain_width = width;
        in_block := head.parent < 0 || tokens.*[head.parent].block;
        at = first_call;
        while at <= end {
            if fmt_member_dot(&tokens.*[at]) {
                tokens.*[at].chain = root;
                if in_block && fmt_newlines(source[tokens.*[at - 1].end..tokens.*[at].start]) > 0
                    head.chain_vertical = true;
            }
            if fmt_open(tokens.*[at].text) at = tokens.*[at].pair + 1;
            else                           at += 1;
        }
    }
}

// One arm of a braceless if/else chain. `keyword` is the arm's `if`, or the
// `else` of a final arm, which has no condition. The body must be a single
// statement ending in `;` at the chain's level, without nested control flow,
// blocks, or comments; otherwise `end` stays -1.
Fmt_If_Arm :: struct {
    condition: ssize = -1;
    body: ssize = -1;
    end: ssize = -1;
    condition_width: ssize;
    body_width: ssize;
    newline: bool;
}
fmt_flat_span :: (tokens: []Fmt_Token, first: ssize, stop: ssize) -> ssize {
    width: ssize = 0;
    at := first;
    while at < stop {
        if at > first && tokens[at].space width += 1;
        width += tokens[at].flat_width;
        if fmt_open(tokens[at].text) at = tokens[at].pair + 1;
        else                         at += 1;
    }
    return width;
}
fmt_if_arm :: (source: str, tokens: []Fmt_Token, keyword: ssize) -> Fmt_If_Arm {
    arm: Fmt_If_Arm;
    if tokens[keyword].kind == "If" arm.condition = keyword + 1;
    at := keyword + 1;
    while at < tokens.count {
        token := &tokens[at];
        kind := token.kind;
        if fmt_comment(kind) || token.hardline || token.block || token.format_disabled return arm;
        nested := kind == "If" || kind == "Ifx" || kind == "Else" || kind == "For" || kind == "While";
        if nested || kind == "Case" || token.text == "#if"           return arm;
        if fmt_newlines(source[tokens[at - 1].end..token.start]) > 0 arm.newline = true;
        // The condition ends where a statement starts after a complete operand.
        if arm.body < 0 && (arm.condition < 0 || (at > arm.condition && !token.operand_context)) {
            statement := (kind == "Ident" && token.text != "in") || kind == "Return" || kind == "Break"
                || kind == "Continue" || kind == "Defer" || kind == "Directive";
            operator := token.prefix || token.binary || token.suffix;
            if      statement && !operator arm.body = at;
            else if arm.condition < 0      return arm;
        }
        if token.text == ";" {
            if arm.body < 0 return arm;
            if arm.condition >= 0
                arm.condition_width = fmt_flat_span(tokens, arm.condition, arm.body);
            arm.body_width = fmt_flat_span(tokens, arm.body, at + 1);
            arm.end = at;
            return arm;
        }
        if fmt_open(token.text) at = token.pair + 1;
        else                    at += 1;
    }
    return arm;
}
// Columns relative to the chain's `if`: conditions follow `else if ` when the
// chain has one, and bodies follow the widest condition.
fmt_if_condition_column :: (head: *Fmt_Token) -> ssize {
    if head.if_else_if return 8;
    return 3;
}
fmt_if_body_column :: (head: *Fmt_Token) -> ssize {
    return fmt_if_condition_column(head) + head.if_condition_width + 1;
}
// Overflowing conditions break after their loosest logical operator at the
// top level: `||` binds looser than `&&` in the Prelude. Each such operator
// records the width of what follows it through the next one, which ends that
// line, or to the end of the condition.
fmt_if_condition_breaks :: (tokens: *[..]Fmt_Token, head: ssize, first: ssize, stop: ssize) {
    operator := "&&";
    at := first;
    while at < stop {
        if tokens.*[at].binary && tokens.*[at].text == "||" operator = "||";
        if fmt_open(tokens.*[at].text) at = tokens.*[at].pair + 1;
        else                           at += 1;
    }
    previous: ssize = -1;
    at = first;
    while at <= stop {
        if at == stop || (tokens.*[at].binary && tokens.*[at].text == operator) {
            if previous >= 0 {
                segment_end := stop;
                if at < stop segment_end = at + 1;
                tokens.*[previous].if_chain = head;
                tokens.*[previous].if_break = true;
                tokens.*[previous].if_segment = fmt_flat_span(
                    tokens.view(),
                    previous + 1,
                    segment_end
                );
            }
            if at == stop return;
            previous = at;
        }
        if fmt_open(tokens.*[at].text) at = tokens.*[at].pair + 1;
        else                           at += 1;
    }
}
// Walks the chain from its first `if`, measuring it or, once measured, marking
// its tokens. A comment around `else`, or any arm that is not a single
// statement, leaves the whole chain to the ordinary layout.
fmt_if_chain :: (source: str, tokens: *[..]Fmt_Token, head: ssize, mark: bool) -> bool {
    view := tokens.view();
    first := &tokens.*[head];
    keyword := head;
    while keyword >= 0 {
        arm := fmt_if_arm(source, view, keyword);
        if arm.end < 0 return false;
        if mark {
            if arm.condition >= 0 {
                tokens.*[arm.condition].if_chain = head;
                tokens.*[arm.condition].if_condition = true;
                fmt_if_condition_breaks(tokens, head, arm.condition, arm.body);
            }
            if keyword == head tokens.*[arm.condition].if_align = fmt_if_condition_column(first);
            tokens.*[arm.body].if_chain = head;
            tokens.*[arm.body].if_body = true;
            tokens.*[arm.end].if_chain = head;
            tokens.*[arm.end].if_body_end = true;
        } else {
            condition := arm.condition_width;
            first.if_arms += 1;
            first.if_end = arm.end;
            if arm.newline                          first.if_newline = true;
            if condition > first.if_condition_width first.if_condition_width = condition;
            if arm.body_width > first.if_body_width first.if_body_width = arm.body_width;
        }
        if arm.condition < 0 return true;
        next := fmt_next_code(view, arm.end + 1);
        if next >= view.count || view[next].kind != "Else" return true;
        after := fmt_next_code(view, next + 1);
        // `else;` is the default arm of an enclosing case block.
        if after < view.count && view[after].text == ";"                   return true;
        if next != arm.end + 1 || after != next + 1 || after >= view.count return false;
        keyword = next;
        if view[after].kind == "If" {
            keyword = after;
            if !mark {
                first.if_else_if = true;
                gap := source[view[next].end..view[after].start];
                if fmt_newlines(gap) > 0 first.if_newline = true;
            }
        }
    }
    return true;
}
// Braceless if/else chains whose arms all fit on one line align conditions and
// bodies into columns; otherwise every body takes its own line, indented. A
// line break inside any arm also requests that layout. A lone `if` is a
// one-arm chain, so its body joins the condition only while the line fits.
// A lone `if` directly followed by another, with no blank line or comment
// between them, may share its body column (see fmt_if_group). When disabled,
// no chain is marked and every `if` keeps the ordinary layout.
fmt_if_chains :: (source: str, tokens: *[..]Fmt_Token, enabled: bool) {
    for i: 0..tokens.*.count {
        token := &tokens.*[i];
        token.if_chain = -1;
        token.if_next = -1;
        token.if_end = -1;
        token.if_arms = 0;
        token.if_grouped = false;
        token.if_align = 0;
        token.if_condition = false;
        token.if_break = false;
        token.if_segment = 0;
        token.if_body = false;
        token.if_body_end = false;
        token.if_else_if = false;
        token.if_newline = false;
        token.if_condition_width = 0;
        token.if_body_width = 0;
        token.if_column = 0;
        token.if_table = false;
    }
    if !enabled return;
    for i: 0..tokens.*.count {
        token := &tokens.*[i];
        if token.kind != "If" || token.format_disabled        continue;
        if token.parent >= 0 && !tokens.*[token.parent].block continue;
        // Chains start at statements, not at `else if` arms or nested bodies.
        previous := fmt_previous_code(tokens.view(), i - 1);
        if previous >= 0 {
            before := tokens.*[previous].text;
            if before != ";" && before != "{" && before != "}" continue;
        }
        if !fmt_if_chain(source, tokens, i, false) continue;
        token.if_chain = i;
        _ = fmt_if_chain(source, tokens, i, true);
    }
    for i: 0..tokens.*.count {
        token := &tokens.*[i];
        if token.if_chain != i || token.if_arms != 1 continue;
        next := token.if_end + 1;
        if next >= tokens.*.count continue;
        following := &tokens.*[next];
        if following.if_chain != next || following.if_arms != 1                  continue;
        if fmt_newlines(source[tokens.*[token.if_end].end..following.start]) > 1 continue;
        token.if_next = next;
    }
}
// Consecutive lone ifs from `head` share one body column while their aligned
// lines fit the width. A member with a line break, or one that would push the
// shared columns past the width, ends the group; it can start the next one.
fmt_if_group :: (tokens: *[..]Fmt_Token, head: ssize, width: ssize) {
    first := &tokens.*[head];
    start := first.if_column + fmt_if_condition_column(first);
    condition := first.if_condition_width;
    body := first.if_body_width;
    last := head;
    next := first.if_next;
    while next >= 0 {
        member := &tokens.*[next];
        if member.if_newline break;
        wider_condition := condition;
        wider_body := body;
        if member.if_condition_width > wider_condition wider_condition = member.if_condition_width;
        if member.if_body_width > wider_body           wider_body = member.if_body_width;
        if start + wider_condition + 1 + wider_body > width break;
        condition = wider_condition;
        body = wider_body;
        last = next;
        next = member.if_next;
    }
    at := head;
    while at >= 0 {
        member := &tokens.*[at];
        member.if_grouped = true;
        member.if_table = true;
        member.if_condition_width = condition;
        if at == last break;
        at = member.if_next;
    }
}

fmt_after_block :: (text: str, kind: str) -> bool {
    if text == {
    case ";", ",", ",,", ")", "]", "}", "else", ".", ".*", ".&", "(", "[", "?";
        return false;
    else;
        return kind != "Op" && kind != "Range" && kind != "RangeInclusive";
    }
}
fmt_layout :: (source: str, tokens: *[..]Fmt_Token, indent: ssize, tabs: bool, width: ssize) -> str {
    writer: Fmt_Writer = .{ .indent = indent, .tabs = tabs };
    defer writer.out.free();
    if source.starts_with("\u{feff}") writer.out.write_string("\u{feff}");
    previous_end: ssize = 0;
    asm_template := false;
    for i: 0..tokens.*.count {
        token := &tokens.*[i];
        text := token.text;
        gap := source[previous_end..token.start];
        lines := fmt_newlines(gap);
        // A break around a breakable condition operator moves after it.
        break_before := false;
        if token.if_break && !tokens.*[token.if_chain].if_table {
            break_before = lines > 0;
            lines = 0;
        }
        if i > 0 && tokens.*[i - 1].if_break {
            if !tokens.*[tokens.*[i - 1].if_chain].if_table lines = 0;
        }
        comment := fmt_comment(token.kind);
        trailing_comment := comment && i > 0 && lines == 0;
        in_block := token.parent < 0;
        if token.parent >= 0 in_block = tokens.*[token.parent].block;
        member := fmt_member_dot(token);
        chain_dot := member && token.chain >= 0;
        if fmt_close(text) {
            open := &tokens.*[token.pair];
            if open.block {
                writer.continuation = false;
                writer.control_header = false;
            }
            if open.arm_body writer.depth -= 1;
            if open.multiline {
                if open.visibility_group fmt_blank_line(&writer);
                else {
                    if !open.case_block writer.depth -= 1;
                    fmt_newline(&writer);
                }
            }
        }
        next_code := fmt_next_code(tokens.view(), i + 1);
        default_arm := token.kind == "Else" && next_code < tokens.*.count && tokens.*[next_code].text == ";";
        if token.parent >= 0 && tokens.*[token.parent].case_block && (
            token.kind == "Case" || default_arm
        ) {
            parent := &tokens.*[token.parent];
            if parent.arm_body writer.depth -= 1;
            parent.arm_body = false;
            parent.arm_header = true;
            fmt_newline(&writer);
        }
        if writer.blank_pending && !trailing_comment {
            fmt_blank_line(&writer);
            writer.blank_pending = false;
        } else if writer.pending && !trailing_comment fmt_newline(&writer);
        if i > 0 && lines > 0 {
            prev := &tokens.*[i - 1];
            if in_block && !comment && !fmt_close(text) && text != "{" && text != "else" {
                if token.binary || prev.binary || prev.text == ":=" || prev.text == "=" ||
                   prev.text == "::" ||
                   (member && !chain_dot)
                    writer.continuation = true;
                if writer.control_header && !token.operand_context &&
                   (
                       token.kind == "Ident" || token.kind == "Return" || token.kind == "Break" || token.kind == "Continue"
                   )
                    writer.continuation = true;
            }
            if (in_block || comment || prev.kind == "LineComment" || token.kind == "MlStr") &&
               !fmt_close(text) && text != "{" && text != "else" && text != ";" &&
               text != "," &&
               !fmt_open(prev.text) && !chain_dot
                fmt_newline(&writer);
            if lines > 1 && !fmt_close(text) && text != "else" && text != "{" && in_block &&
               (prev.text == ";" || prev.text == "}" || fmt_comment(prev.kind))
                fmt_blank_line(&writer);
        }
        if token.kind == "MlStr" fmt_newline(&writer);
        if text == "{" || text == "else" || token.kind == "Case" {
            writer.continuation = false;
            writer.control_header = false;
        }
        if token.kind == "If" || token.kind == "While" || token.kind == "For" || text == "#if"
            writer.control_header = true;
        // Assembly lines are block contents, not multiline string expressions.
        if text == "{" {
            previous := fmt_previous_code(tokens.view(), i - 1);
            asm_template = previous >= 0 && tokens.*[previous].text == "#asm";
        } else if token.kind != "MlStr" && !comment asm_template = false;
        extra: ssize = 0;
        if token.kind == "MlStr" && !asm_template extra = 1;
        // Vertical chains put each element on its own line. Leading elements
        // join the root while its line ends left of the elements' indentation.
        if chain_dot && tokens.*[token.chain].chain_vertical {
            head := &tokens.*[token.chain];
            indentation := writer.depth * writer.indent;
            if writer.continuation && writer.condition_align > 0
                indentation += writer.condition_align;
            else if writer.continuation
                indentation += writer.indent;
            joins := head.chain_indented && writer.column <= indentation;
            if head.chain_broken || !joins {
                fmt_newline(&writer);
                head.chain_broken = true;
            }
        }
        // Aligned chains pad to their columns; a group of lone ifs shares the
        // body column. Other chains put each body on its own line one level
        // deep, and a condition that overflows breaks after its loosest
        // logical operators, continuing under the condition's first token.
        aligned := false;
        if token.if_chain >= 0 && token.if_chain != i {
            head := &tokens.*[token.if_chain];
            if head.if_table {
                align := token.if_align;
                if token.if_body align = fmt_if_body_column(head);
                if align > 0 && !writer.line_start {
                    fmt_pad(&writer, head.if_column + align - writer.column);
                    aligned = true;
                }
            } else if token.if_body {
                writer.continuation = false;
                writer.condition_align = 0;
                fmt_newline(&writer);
                writer.depth += 1;
            }
        }
        fmt_write(&writer, text, token.space && !aligned, extra);
        if token.if_chain == i {
            token.if_column = writer.column - fmt_width(text);
            if !token.if_grouped {
                token.if_table = !token.if_newline
                    && token.if_column + fmt_if_body_column(token) + token.if_body_width <= width;
                if token.if_table fmt_if_group(tokens, i, width);
            }
        } else if token.if_chain >= 0 && !tokens.*[token.if_chain].if_table {
            if token.if_condition {
                writer.condition_align = writer.column - fmt_width(text) - writer.depth * writer.indent;
            } else if token.if_break {
                after := fmt_newlines(source[token.end..tokens.*[i + 1].start]) > 0;
                if break_before || after || writer.column + 1 + token.if_segment > width {
                    writer.continuation = true;
                    fmt_newline(&writer);
                }
            }
        }
        if fmt_open(text) {
            nonempty := token.pair > i + 1;
            token.multiline = nonempty && (
                token.hardline || (
                    text != "[" && writer.column - fmt_width(text) + token.flat_width > width
                )
            );
            if token.multiline {
                // Delay the blank line until after any opening-line comments.
                if token.visibility_group writer.blank_pending = true;
                // Case arms align with the `if`/`#if` that owns them; only
                // their bodies indent.
                else if !token.case_block writer.depth += 1;
                writer.pending = true;
            }
        } else if text == ";" {
            if token.parent >= 0 && tokens.*[token.parent].arm_header {
                tokens.*[token.parent].arm_header = false;
                tokens.*[token.parent].arm_body = true;
                writer.depth += 1;
            }
            if in_block {
                writer.pending = true;
                writer.continuation = false;
                writer.condition_align = 0;
                writer.control_header = false;
            } else if token.parent >= 0 && tokens.*[token.parent].text == ".[" && tokens.*[token.parent].multiline writer.pending = true;
            if token.if_body_end && !tokens.*[token.if_chain].if_table writer.depth -= 1;
        } else if text == "," || text == ",," {
            if token.parent >= 0 && tokens.*[token.parent].multiline &&
               !tokens.*[token.parent].block &&
               !token.lambda_parameter && !token.directive_modifier
                writer.pending = true;
        } else if text == "}" && tokens.*[token.pair].block {
            next := i + 1;
            if next < tokens.*.count &&
               (
                   tokens.*[next].type_head_start || fmt_after_block(
                       tokens.*[next].text,
                       tokens.*[next].kind
                   )
               )
                writer.pending = true;
        }
        // Chains inside a group break only once the group itself has.
        if token.chain_width > 0 && !token.chain_vertical {
            parent_open := token.parent < 0 || tokens.*[token.parent].block
                || tokens.*[token.parent].multiline;
            start := writer.column - fmt_width(text);
            token.chain_vertical = parent_open && start + token.chain_width > width;
        }
        if token.chain >= 0 {
            head := &tokens.*[token.chain];
            // A multiline root ending in its closing delimiter is block-like
            // (rustfmt); its elements stay at the root's indentation.
            if head.chain_root_end == i && head.chain_vertical
                && (!fmt_close(text) || !tokens.*[token.pair].multiline) {
                writer.depth += 1;
                head.chain_indented = true;
            }
            if head.chain_end == i && head.chain_indented {
                writer.depth -= 1;
                head.chain_indented = false;
            }
        }
        // Keep computing layout while output is disabled, including delimiter
        // and match-arm depth. Resume with the original bytes through the on
        // comment, so its leading whitespace cannot alter the disabled region.
        if token.format_disabled && writer.disabled_start < 0 {
            writer.disabled_start = token.end;
        } else if !token.format_disabled && writer.disabled_start >= 0 {
            writer.out.write_string(source[writer.disabled_start..token.end]);
            writer.disabled_start = -1;
        }
        if token.kind == "LineComment" || token.kind == "MlStr" fmt_newline(&writer);
        previous_end = token.end;
    }
    if writer.disabled_start >= 0 writer.out.write_string(source[writer.disabled_start..]);
    else                          fmt_newline(&writer);
    return value_take(&writer.out).into_string();
}

fmt_verified :: (formatted: str, tokens: []Fmt_Token) -> bool {
    scanned := glosso_tokens(formatted);
    defer scanned.free();
    if !scanned.success return false;
    at: ssize = 0;
    for token: scanned.tokens.view() {
        if fmt_trivia(token.kind) continue;
        if at >= tokens.count || tokens[at].kind != token.kind ||
           tokens[at].text != formatted[token.start..token.end]
            return false;
        at += 1;
    }
    return at == tokens.count;
}

fmt_checked_layout :: (
    source: str,
    fallback: str,
    tokens: *[..]Fmt_Token,
    indent: ssize,
    tabs: bool,
    width: ssize,
    format_braceless_if: bool
) -> str {
    fmt_measure(tokens);
    fmt_chains(source, tokens);
    fmt_if_chains(source, tokens, format_braceless_if);
    formatted := fmt_layout(source, tokens, indent, tabs, width);
    if fmt_verified(formatted, tokens.view()) return formatted;
    formatted.free();
    return fallback.clone();
}

#public fmt_format :: (
    source: str,
    indent: ssize = 4,
    tabs: bool = false,
    width: ssize = 100,
    source_path: str = "",
    std_directory: str = GLOSSO_STANDARD_DIRECTORY,
    format_braceless_if: bool = true,
) -> str {
    scanned := glosso_tokens(source);
    defer scanned.free();
    if !scanned.success return source.clone();
    original := fmt_tokens(source, &scanned);
    defer original.free();
    if !fmt_pairs(&original) return source.clone();
    ops := fmt_default_operators();
    defer ops.free();
    fmt_declarations(&ops, original.view());
    fmt_spacing(&original, &ops);
    if fmt_needs_imports(&ops, original.view()) {
        fmt_import_operators(&ops, original.view(), source_path, std_directory);
        fmt_spacing(&original, &ops);
    }
    normalized := fmt_normalize_operators(source, original.view(), &ops);
    defer normalized.free();
    if indent < 1 || indent > 16  indent = 4;
    if width < 20 || width > 1000 width = 100;
    if normalized == source
        return fmt_checked_layout(
            source,
            source,
            &original,
            indent,
            tabs,
            width,
            format_braceless_if
        );
    normalized_scan := glosso_tokens(normalized);
    defer normalized_scan.free();
    if !normalized_scan.success return source.clone();
    tokens := fmt_tokens(normalized, &normalized_scan);
    defer tokens.free();
    if !fmt_pairs(&tokens) return source.clone();
    fmt_spacing(&tokens, &ops);
    return fmt_checked_layout(normalized, source, &tokens, indent, tabs, width, format_braceless_if);
}
