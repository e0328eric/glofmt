//! User configuration at get_config_dir()/glofmt/config.toml.
#import "File_System/Directory";
#import "File_System/File";
#import "File_System/Path";
#import "Format";
#import "Serialization/Core";
#import "Serialization/Toml";
#import "Strings";

#public Fmt_Config :: struct {
    width: ssize = 100;
    // false leaves braceless if/else chains to the ordinary layout, which
    // keeps their line breaks, instead of aligning or breaking them.
    format_braceless_if: bool = true;
}

fmt_config_error :: (path: str, message: str) -> ?Fmt_Config {
    error := File.stderr();
    _ = error.write(tprint("glofmt: {}: {}\n", path, message));
    return null;
}

// Missing configuration uses the default; failures are reported before input
// is read or any source file can be replaced.
#public fmt_config :: () -> ?Fmt_Config {
    config: Fmt_Config;
    directory: Path;
    if get_config_dir() == {
    case null;
        return ?config;
    case ?path;
        directory = path;
    }
    defer directory.free();
    base := directory.to_string();
    defer base.free();
    path := path_join(base, "glofmt/config.toml");
    defer path.free();

    input: File;
    if File.open(path) == {
    case .Ok(file);
        input = file;
    case .Err(failure);
        if failure.kind == .Not_Found return ?config;
        return fmt_config_error(path, failure.kind.reason());
    }
    defer input.close();
    source: str;
    if input.read_all() == {
    case .Ok(text);
        source = text;
    case .Err(failure);
        return fmt_config_error(path, failure.kind.reason());
    }
    defer source.free();

    document: Serialization_Document;
    if Serialization_Document.toml_document_from_string(source) == {
    case .Ok(parsed);
        document = parsed;
    case .Err(failure);
        return fmt_config_error(
            path,
            tprint("invalid TOML at byte {}: {}", failure.offset, failure.message)
        );
    }
    defer document.destroy();
    if document.root.field_value("width") == {
    case null;
    case ?value;
        valid := false;
        if deserialize(ssize, value) == {
        case .Ok(width);
            config.width = width;
            valid = width >= 20 && width <= 1000;
        case .Err;
        }
        if !valid return fmt_config_error(path, "width must be an integer from 20 through 1000");
    }
    if document.root.field_value("format_braceless_if") == {
    case null;
    case ?value;
        if deserialize(bool, value) == {
        case .Ok(enabled);
            config.format_braceless_if = enabled;
        case .Err;
            return fmt_config_error(path, "format_braceless_if must be true or false");
        }
    }
    return ?config;
}
